"SecondItemNPC2": "res://Dialogues/NPC Dialogue/Water/SecondItemNPC2.dtl",
"SecondItemNPC3": "res://Dialogues/NPC Dialogue/Water/SecondItemNPC3.dtl",
"SecondItemNPC4": "res://Dialogues/NPC Dialogue/Water/SecondItemNPC4.dtl",
"SwitchHint": "res://Dialogues/NPC Dialogue/Water/SwitchHint.dtl",
"Test": "res://Dialogues/Test.dtl",
"WaterExit1": "res://Dialogues/Scene Dialogue/Water/WaterExit1.dtl",
"WaterExit2": "res://Dialogues/Scene Dialogue/Water/WaterExit2.dtl",
"WaterExitSolo": "res://Dialogues/Scene Dialogue/Water/WaterExitSolo.dtl",
"Win": "res://Dialogues/Win.dtl",
"bridgeBattleStartTest": "res://Dialogues/bridgeBattleStartTest.dtl",
"bridgejoke1": "res://Dialogues/bridgejoke1.dtl"

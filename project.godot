text/autoadvance_per_word_delay=0
layout/end_behaviour=0
timer/process_in_physics=true
translation/save_mode=0
translation/add_separator=true
choices/hotkey_behaviour=0
text/split_at_new_lines=false
translation/id_counter=315
translation/locales=[]
save/autosave=false
layout/style_list=["res://DialogicStyles/Base.tres", "res://DialogicStyles/No-Box.tres", "res://DialogicStyles/No-Box-Dark.tres"]
layout/default_style=""
portraits/default_portrait=""
extensions_folder="res://addons/dialogic_additions"
translation/intern/save_mode=0
translation/intern/file_mode=0
translation/intern/translation_folder="res://Dialogues/Español"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Godot"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/MonoCustomResourceRegistry/plugin.cfg", "res://addons/dialogic/plugin.cfg")

